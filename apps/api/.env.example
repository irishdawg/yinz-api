ENVIRONMENT=development

# SUPABASE_URL is consumed by auth.py — verifies session JWTs against
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 fallback — leave empty unless your project's JWKS endpoint
# (SUPABASE_URL/auth/v1/.well-known/jwks.json) returns no keys.
SUPABASE_JWT_SECRET=

# Shared secret the Next.js gateway sends as X-Gotiate-Gateway-Key. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GOTIATE_GATEWAY_SECRET=

# Direct Postgres connection for PostgresGameRepository (SELECT ... FOR
# UPDATE, multi-statement transactions — not available through PostgREST).
# Supavisor session-mode pooler, port 5432, role gotiate_backend. See
# DATABASE.md. Leave empty for local dev against InMemoryGameRepository
# (main.py falls back to in-memory when this is unset).
GOTIATE_BACKEND_DATABASE_URL=
GOTIATE_DB_POOL_MIN_SIZE=1
GOTIATE_DB_POOL_MAX_SIZE=5
